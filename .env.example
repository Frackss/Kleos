# All variables are SERVER ONLY. Never use a NEXT_PUBLIC_ prefix for these keys.
# Leave both Supabase values blank for temporary, process-local demo storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required only for live AI scans. No fake results are produced when absent.
PERPLEXITY_API_KEY=
# Optional Agent API model ID. Blank uses the fast effort preset with web search.
# Legacy sonar model values are mapped to documented Agent effort presets.
PERPLEXITY_MODEL=

# No user authentication or Supabase Auth setup is required.
